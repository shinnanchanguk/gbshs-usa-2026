+const PRIVATE_NOTES_KEY = 'private-notes:v1'
+const EMPTY_PRIVATE_NOTES: PrivateNoteBook = { version: 1, entries: [] }
+// 저장 실패 여부는 기기에 영구 기록하지 않는다. 실패한 본문은 storage의 메모리 대체 저장을 사용한다.
+const privateNoteFailures = new Set<string>()
+const privateNoteFailureKey = (owner: string, pageKey: string) => JSON.stringify([owner, pageKey])
+
+/** 개인 메모는 제출·사진·보고서·교사/보호자 열람과 분리한다. 향후 DB 연결도 여기서 한다. */
+export function usePrivateNotes(owner: string | null) {
+  const [raw] = useStored<unknown>(PRIVATE_NOTES_KEY, EMPTY_PRIVATE_NOTES)
+  const [failures, setFailures] = useState(() => new Set(privateNoteFailures))
+  const book = useMemo(() => notesForOwner(raw, owner), [raw, owner])
+  const save = useCallback((pageKey: string, text: string | null) => {
+    if (!owner) return false
+    const next = changePrivateNote(readStored(PRIVATE_NOTES_KEY, EMPTY_PRIVATE_NOTES), owner, pageKey, text)
+    const persisted = writeStored(PRIVATE_NOTES_KEY, next)
+    const id = privateNoteFailureKey(owner, pageKey)
+    if (persisted) privateNoteFailures.clear()
+    else privateNoteFailures.add(id)
+    setFailures(new Set(privateNoteFailures))
+    return persisted
+  }, [owner])
+  return { book, save, failed: (pageKey: string) => !!owner && isStoredPending(PRIVATE_NOTES_KEY) && failures.has(privateNoteFailureKey(owner, pageKey)) }
+}
